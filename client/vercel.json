{
  "rewrites": [
    {
      "source": "/api",
      "destination": "https://ecotrack-server-sooty.vercel.app/api/"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://ecotrack-server-sooty.vercel.app/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
